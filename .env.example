# Copy this file to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
AUTH_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecosystem_auth
DATABASE_SSL=false
SESSION_COOKIE_NAME=ecosystem_session
TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
# Yandex Mail SMTP. For @yandex.ru mailboxes SMTP_USER is the login before @.
# SMTP_FROM_EMAIL is optional; it defaults to SMTP_USER@yandex.ru for this host.
# Use a Yandex app password, never your regular account password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_yandex_login
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NEXORA ID
SMTP_TIMEOUT_MS=15000
OAUTH_CLIENTS_JSON=[]
# OAuth client for NEXORA (secret and API key must each be >= 32 chars; same secret as in nexora service).
NEXORA_CLIENT_SECRET=
NEXORA_SERVICE_API_KEY=
NEXORA_REDIRECT_URI=https://nexora-lobby.onrender.com/auth/callback
# Optional OAuth client for the independent project-generator site.
PROJECTS_OAUTH_CLIENT_SECRET=
PROJECTS_SERVICE_API_KEY=
PROJECTS_REDIRECT_URI=https://vse-proekty-ian-1.onrender.com/auth/callback
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUST_PROXY=false

# Docker Compose: set a random database password, and use the matching DATABASE_URL with host db.
POSTGRES_PASSWORD=
# Optional dedicated server-to-server key for project generation.
PROJECTS_SECURITY_SERVICE_KEY=

# render-internal requires TLS on Render private Postgres; verify-full verifies public certificates.
DATABASE_SSL_MODE=
